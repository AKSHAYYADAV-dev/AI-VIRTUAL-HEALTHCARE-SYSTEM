# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Required for interactive Google Maps & Places API (New) clinic locator.
# Provisioned via Google Maps setup in AI Studio.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# ADMIN_PASSWORD: Set a strong Administrator password via AI Studio Secrets before sharing or deploying.
# When unset on first run, the Admin login portal provides a one-time setup form to claim the password.
ADMIN_PASSWORD=

# DEMO_DOCTOR_PASSWORD: Optional password for seeded preview Doctor accounts.
# When unset, unclaimed preview doctor accounts use the one-time first-run claim form.
DEMO_DOCTOR_PASSWORD=

# DEMO_PATIENT_PASSWORD: Optional password for seeded preview Patient accounts.
# When unset, unclaimed preview patient accounts use the one-time first-run claim form (or patients can sign up directly).
DEMO_PATIENT_PASSWORD=


